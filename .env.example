APP_NAME=TELONYX AutoEdit Web
APP_ENV=production
APP_PUBLIC_BASE_URL=https://your-service.up.railway.app
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/telonyx_autoedit
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=/data/storage
YOLO_MODEL=yolov8n.pt
WHISPER_MODEL=small
MAX_UPLOAD_MB=1200
DEFAULT_TARGET_SECONDS=30
