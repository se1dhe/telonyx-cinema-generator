APP_NAME=TELONYX Cinema Generator
APP_ENV=production
APP_PUBLIC_BASE_URL=https://your-service.up.railway.app
PYTHONPATH=/app/src
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=/data/storage
MAX_UPLOAD_MB=1200
DEFAULT_TARGET_SECONDS=30
ENABLE_YOLO=true
ENABLE_BEAT_DETECT=true
ENABLE_WHISPER=false
ENABLE_CLIP=false
MODEL_DEVICE=cpu
COMPUTE_TYPE=int8
YOLO_MODEL=yolov8n.pt
WHISPER_MODEL=base
